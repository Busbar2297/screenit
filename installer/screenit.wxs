<?xml version="1.0" encoding="UTF-8"?>
<!--
  screenIt per-user installer (WiX Toolset v3, free / MS-RL).
  Built by `cargo xtask msi`, which fills the FILES and REFS marker comments below from the
  staged release folder. Per-user: installs to %LOCALAPPDATA%\Programs\screenIt, no admin rights.

  Optional property: STARTUP=1 (default) starts screenIt minimized in the tray when you sign in;
  install with `msiexec /i screenit.msi STARTUP=0` to skip it.
  Optional property: DESKTOP=1 (default) adds a Desktop shortcut; DESKTOP=0 skips it. The Settings view can change it later.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="screenIt" Language="1033" Version="$(var.Version)"
           Manufacturer="screenIt" UpgradeCode="8B5E9C41-3F6A-4D7B-9A21-5C7D0E4F1B62">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="screenIt screen capture, recording and annotation" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of screenIt is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="STARTUP" Value="1" />
    <Property Id="DESKTOP" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="screenIt">
            <!--FILES-->
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="*">
      <Shortcut Id="AppShortcut" Name="screenIt" Description="Screen capture and recording"
                Target="[INSTALLFOLDER]screenit.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\screenIt" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopLink" Directory="DesktopFolder" Guid="*">
      <Condition>DESKTOP = "1"</Condition>
      <Shortcut Id="DesktopShortcut" Name="screenIt" Description="Screen capture and recording"
                Target="[INSTALLFOLDER]screenit.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\screenIt" Name="DesktopLink" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartupRun" Directory="INSTALLFOLDER" Guid="*">
      <Condition>STARTUP = "1"</Condition>
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="screenIt"
                     Type="string" Value="&quot;[INSTALLFOLDER]screenit.exe&quot; --minimized" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="screenIt" Level="1">
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="DesktopLink" />
      <ComponentRef Id="StartupRun" />
      <!--REFS-->
    </Feature>
  </Product>
</Wix>
